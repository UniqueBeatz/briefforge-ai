@import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap');

:root {
  --bg: #0a1020;
  --bg-soft: #111c2f;
  --surface: rgba(19, 29, 48, 0.92);
  --surface-strong: #15243d;
  --border: rgba(148, 163, 184, 0.18);
  --text: #edf3ff;
  --muted: #a3b6d6;
  --primary: #7c9cff;
  --primary-strong: #5b82ff;
  --accent: #8ef0d6;
  --shadow: 0 20px 45px rgba(15, 23, 42, 0.45);
}

* {
  box-sizing: border-box;
}

html, body, #root {
  margin: 0;
  min-height: 100%;
  width: 100%;
  font-family: 'Inter', sans-serif;
  background:
    radial-gradient(circle at top left, rgba(124, 156, 255, 0.18), transparent 25%),
    radial-gradient(circle at bottom right, rgba(142, 240, 214, 0.11), transparent 28%),
    var(--bg);
  color: var(--text);
}

button, input {
  font: inherit;
}

button {
  cursor: pointer;
}

.app-shell {
  display: grid;
  grid-template-columns: 280px 1fr;
  min-height: 100vh;
}

.sidebar {
  border-right: 1px solid var(--border);
  background: rgba(10, 16, 32, 0.8);
  backdrop-filter: blur(12px);
  padding: 28px 20px;
}

.brand-block {
  display: flex;
  align-items: center;
  gap: 14px;
  margin-bottom: 28px;
}

.brand-mark {
  width: 44px;
  height: 44px;
  border-radius: 14px;
  background: linear-gradient(135deg, var(--primary), #6de5ff);
  display: grid;
  place-items: center;
  font-weight: 800;
  color: #081322;
}

.brand-block h1 {
  margin: 0;
  font-size: 1.3rem;
}

.eyebrow {
  margin: 0 0 6px;
  font-size: 0.72rem;
  letter-spacing: 0.12em;
  text-transform: uppercase;
  color: var(--muted);
}

.nav-stack {
  display: flex;
  flex-direction: column;
  gap: 10px;
  margin-bottom: 26px;
}

.nav-item {
  border: 1px solid transparent;
  border-radius: 12px;
  padding: 10px 12px;
  background: transparent;
  color: var(--text);
  text-align: left;
  transition: 0.2s ease;
}

.nav-item.active,
.nav-item:hover {
  background: rgba(124, 156, 255, 0.12);
  border-color: rgba(124, 156, 255, 0.2);
}

.side-card,
.form-card,
.insight-card,
.output-card,
.library-section,
.pricing-section {
  background: var(--surface);
  border: 1px solid var(--border);
  border-radius: 18px;
  box-shadow: var(--shadow);
}

.side-card {
  padding: 18px;
}

.side-card h3 {
  margin: 12px 0 8px;
  font-size: 1.45rem;
}

.side-card p {
  margin: 0;
  color: var(--muted);
  font-size: 0.9rem;
}

.main-panel {
  padding: 28px;
}

.topbar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24px;
}

.topbar h2 {
  margin: 0;
  font-size: clamp(1.7rem, 2vw, 2.5rem);
}

.topbar-meta {
  display: flex;
  align-items: center;
  gap: 12px;
  color: var(--muted);
}

.hero-grid {
  display: grid;
  grid-template-columns: minmax(0, 2fr) minmax(240px, 0.9fr);
  gap: 20px;
  margin-bottom: 22px;
}

.form-card {
  padding: 20px;
}

.card-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 12px;
  margin-bottom: 16px;
}

.card-header h3 {
  margin: 0;
  font-size: 1.2rem;
}

.field-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 16px;
  margin-bottom: 18px;
}

label {
  display: flex;
  flex-direction: column;
  gap: 8px;
  color: var(--muted);
}

label span {
  font-size: 0.84rem;
}

input {
  border: 1px solid var(--border);
  background: rgba(15, 23, 42, 0.7);
  color: var(--text);
  border-radius: 12px;
  padding: 11px 12px;
  outline: none;
}

input:focus {
  border-color: rgba(124, 156, 255, 0.9);
  box-shadow: 0 0 0 3px rgba(124, 156, 255, 0.15);
}

.wide-field {
  grid-column: 1 / -1;
}

.tone-row,
.content-toggle {
  display: flex;
  flex-direction: column;
  gap: 12px;
  margin-top: 18px;
}

.tone-label {
  color: var(--muted);
  font-size: 0.84rem;
}

.pill-group {
  display: flex;
  flex-wrap: wrap;
  gap: 8px;
}

.pill,
.primary-button,
.ghost-button,
.copy-actions button {
  border: 1px solid var(--border);
  border-radius: 999px;
  background: rgba(148, 163, 184, 0.08);
  color: var(--text);
  padding: 9px 12px;
  transition: 0.2s ease;
}

.pill.active,
.primary-button {
  background: linear-gradient(135deg, var(--primary), var(--primary-strong));
  border-color: transparent;
  color: white;
}

.primary-button {
  border: none;
  padding: 12px 18px;
  font-weight: 700;
  transition: transform 0.2s ease, filter 0.2s ease;
}

.primary-button:hover,
.ghost-button:hover,
.pill:hover,
.copy-actions button:hover {
  transform: translateY(-1px);
  filter: brightness(1.05);
}

.generate-button {
  margin-top: 20px;
  width: 100%;
}

.ghost-button {
  background: transparent;
}

.small {
  font-size: 0.8rem;
  padding: 9px 14px;
}

.error-text {
  margin: 12px 0 0;
  color: #ffb4b4;
}

.insight-card {
  padding: 20px;
}

.insight-card h3 {
  margin: 0 0 18px;
  font-size: 1.4rem;
}

.insight-card ul {
  list-style: none;
  margin: 0 0 22px;
  padding: 0;
  display: flex;
  flex-direction: column;
  gap: 8px;
  color: var(--muted);
}

.mini-metrics {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 12px;
}

.mini-metrics div {
  border: 1px solid var(--border);
  background: rgba(148, 163, 184, 0.05);
  border-radius: 14px;
  padding: 14px;
}

.mini-metrics span {
  display: block;
  font-size: 0.72rem;
  color: var(--muted);
  margin-bottom: 8px;
}

.output-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 18px;
  margin-bottom: 20px;
}

.output-card,
.library-section,
.pricing-section {
  padding: 18px;
}

.copy-list {
  display: flex;
  flex-direction: column;
  gap: 12px;
}

.copy-item {
  border: 1px solid var(--border);
  border-radius: 14px;
  background: rgba(148, 163, 184, 0.04);
  padding: 12px;
}

.copy-item p {
  margin: 0 0 10px;
  color: var(--text);
  line-height: 1.6;
}

.copy-actions {
  display: flex;
  justify-content: flex-end;
  gap: 8px;
}

.copy-actions button {
  background: rgba(124, 156, 255, 0.08);
  padding: 7px 10px;
  font-size: 0.78rem;
}

.empty-state {
  display: grid;
  place-items: center;
  min-height: 80px;
  color: var(--muted);
  border: 1px dashed var(--border);
  border-radius: 14px;
  background: rgba(148, 163, 184, 0.02);
}

.full-width {
  width: 100%;
}

.library-section {
  margin-bottom: 20px;
}

.library-grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 14px;
}

.library-item {
  background: rgba(148, 163, 184, 0.04);
  border: 1px solid var(--border);
  border-radius: 14px;
  padding: 16px;
}

.library-item span {
  display: block;
  margin-bottom: 8px;
  font-weight: 700;
}

.library-item p {
  margin: 0 0 12px;
  color: var(--muted);
  line-height: 1.6;
}

.library-item button {
  border: 1px solid var(--border);
  border-radius: 999px;
  background: transparent;
  color: var(--text);
  padding: 7px 10px;
}

.pricing-grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 14px;
}

.pricing-card {
  background: rgba(148, 163, 184, 0.04);
  border: 1px solid var(--border);
  border-radius: 16px;
  padding: 18px;
}

.pricing-card.featured {
  background: linear-gradient(180deg, rgba(124, 156, 255, 0.18), rgba(148, 163, 184, 0.04));
  border-color: rgba(124, 156, 255, 0.45);
}

.plan-name {
  color: var(--muted);
  font-size: 0.78rem;
  text-transform: uppercase;
  letter-spacing: 0.12em;
}

.pricing-card h4 {
  margin: 14px 0 10px;
  font-size: 2rem;
}

.pricing-card h4 small {
  font-size: 0.9rem;
  color: var(--muted);
}

.pricing-card p {
  color: var(--muted);
  margin: 0 0 12px;
}

.pricing-card ul {
  margin: 0 0 15px;
  padding-left: 18px;
  color: var(--text);
  display: flex;
  flex-direction: column;
  gap: 8px;
}

@media (max-width: 1080px) {
  .app-shell {
    grid-template-columns: 1fr;
  }

  .sidebar {
    border-right: none;
    border-bottom: 1px solid var(--border);
  }
}

@media (max-width: 780px) {
  .hero-grid,
  .output-grid,
  .library-grid,
  .pricing-grid,
  .field-grid {
    grid-template-columns: 1fr;
  }

  .main-panel {
    padding: 18px;
  }

  .topbar {
    flex-direction: column;
    align-items: flex-start;
    gap: 10px;
  }
}
